{
  "name": "paramlib",
  "displayName": "ParamLib",
  "description": "Syntax highlighting, code completion for config.cpp files and rvmats.",
  "author": "FlipperPlz",
  "publisher": "FlipperPlz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlipperPlz/paramlib"
  },
  "license": "UNLICENSED",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "package": "vsce package",
    "vsce:publish": "vsce publish",
    "vsce:prerelease": "vsce publish --pre-release"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "engines": {
    "bun": ">=1.3.12",
    "vscode": "^1.64.0"
  },
  "activationEvents": [
    "workspaceContains:config.cpp",
    "workspaceContains:*.rvmat",
    "onLanguage:paramlib"
  ],
  "main": "./client/dist/clientNode.js",
  "browser": "./client/dist/clientBrowser.js",
  "languages": [
    {
      "id": "paramlib",
      "aliases": [
        "ParamLib",
        "BiConfig"
      ],
      "extensions": [
        ".cpp",
        ".rvmat"
      ],
      "configuration": "./language-configuration.json"
    }
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@vscode/vsce": "3.8.0",
    "@wasm-tool/wasm-pack-plugin": "1.7.0",
    "typescript": "5.9.3",
    "webpack": "5.105.4",
    "webpack-cli": "7.0.2",
    "copy-webpack-plugin": "14.0.0",
    "path-browserify": "1.0.1",
    "swc-loader": "0.2.7"
  }
}
