{
  "name": "paramkit",
  "displayName": "ParamKit",
  "description": "Syntax highlighting, code completion for config.cpp files and rvmats.",
  "author": "FlipperPlz",
  "publisher": "flipperplz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlipperPlz/paramlib"
  },
  "license": "UNLICENSED",
  "version": "0.0.4",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "compile": "webpack",
    "compile:watch": "tsdown --watch",
    "package": "bunx vsce package --no-dependencies",
    "dev:browser": "vscode-test-web --extensionDevelopmentPath=. ./ --open-devtools",
    "vsce:publish": "bunx vsce publish",
    "typecheck": "bun run typecheck --filter='*'"
  },
  "contributes": {
    "configuration": {
      "title": "ParamLib",
      "properties": {
        "paramlib.schemaFile": {
          "type": "string",
          "default": "builtin:dayz",
          "enum": [
            "builtin:dayz",
            "custom"
          ],
          "enumItemLabels": [
            "DayZ",
            "Custom…"
          ],
          "enumDescriptions": [
            "DayZ schema bundled with the extension",
            "Use a custom path or URL (set below in Paramlib: Custom Schema Path)"
          ],
          "description": "ParamLib schema to use. Drives string-value completions for matched param paths."
        },
        "paramlib.schemaClass": {
          "type": "string",
          "default": "",
          "markdownDescription": "Class inside `CfgSchemas` to activate. Leave empty to use the last class in the file. Run **ParamLib: Select Schema Class** to pick from the available list."
        },
        "paramlib.customSchemaPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path or URL to a custom ParamLib JSON schema file. Only used when **Paramlib: Schema File** is set to `custom`."
        }
      }
    },
    "commands": [
      {
        "command": "paramlib.selectSchemaFile",
        "title": "ParamLib: Select Schema File",
        "category": "ParamLib"
      },
      {
        "command": "paramlib.selectSchemaClass",
        "title": "ParamLib: Select Schema Class",
        "category": "ParamLib"
      }
    ]
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "engines": {
    "bun": ">=1.3.12",
    "vscode": "^1.64.0"
  },
  "activationEvents": [
    "workspaceContains:config.cpp",
    "workspaceContains:paramlib.cpp",
    "workspaceContains:*.rvmat",
    "onLanguage:paramlib"
  ],
  "main": "./client/dist/clientNode.js",
  "browser": "./client/dist/clientBrowser.js",
  "languages": [
    {
      "id": "paramlib",
      "aliases": [
        "ParamLib",
        "BiConfig"
      ],
      "extensions": [
        ".cpp",
        ".rvmat"
      ],
      "filenames": [
        "paramlib.cpp"
      ],
      "configuration": "./language-configuration.json"
    }
  ],
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.64.0",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "3.8.0",
    "buffer": "^5.7.1",
    "copy-webpack-plugin": "^13.0.0",
    "path-browserify": "1.0.1",
    "process": "^0.11.10",
    "swc-loader": "^0.2.6",
    "util": "^0.12.5",
    "webpack": "^5.106.2",
    "typescript": "5.9.3",
    "webpack-cli": "^7.0.2"
  }
}
