{
  "name": "paramkit",
  "displayName": "ParamKit",
  "description": "Syntax highlighting, code completion for config.cpp files and rvmats.",
  "author": "FlipperPlz",
  "publisher": "flipperplz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlipperPlz/paramlib"
  },
  "license": "UNLICENSED",
  "version": "0.0.21",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "compile": "webpack --config webpack.config.js",
    "compile:watch": "webpack --config webpack.config.js --watch",
    "package": "bunx vsce package --no-dependencies",
    "dev:browser": "vscode-test-web --extensionDevelopmentPath=. ./test-data --open-devtools",
    "vsce:publish": "bunx vsce publish",
    "typecheck": "bun run typecheck --filter='*'"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "engines": {
    "bun": ">=1.3.12",
    "vscode": "^1.64.0"
  },
  "activationEvents": [
    "workspaceContains:config.cpp",
    "workspaceContains:*.rvmat",
    "onLanguage:paramlib"
  ],
  "main": "./client/dist/clientNode.js",
  "browser": "./client/dist/clientBrowser.js",
  "languages": [
    {
      "id": "paramlib",
      "aliases": [
        "ParamLib",
        "BiConfig"
      ],
      "extensions": [
        ".cpp",
        ".rvmat"
      ],
      "configuration": "./language-configuration.json"
    }
  ],
  "devDependencies": {
    "@swc/core": "latest",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.64.0",
    "@vscode/test-web": "^0.0.80",
    "@vscode/vsce": "3.8.0",
    "copy-webpack-plugin": "14.0.0",
    "path-browserify": "1.0.1",
    "swc-loader": "0.2.7",
    "typescript": "5.9.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  }
}
