class Parent {
    class Youngest {
        class InnerLeast {
            value = 0;
        };
    };
    class Oldest : Youngest {
        class InnerLeast : InnerLeast {
            value = 1;
        };
    };
};


class Parent2 : Parent {
    class Youngest : Youngest {
	    class InnerLeast : InnerLeast {
            value = 2;
        };
    };

    class Oldest : Oldest {
	    class InnerLeast : InnerLeast {
            value = 2;
        };
    };
};
